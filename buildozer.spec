[app]

title = Arnav Downloader
package.name = arnavdownloader
package.domain = org.arnav

source.dir = .
source.include_exts = py,png,jpg,jpeg,kv,atlas

version = 1.0

requirements = python3,kivy,yt-dlp

orientation = portrait

fullscreen = 0


[buildozer]

log_level = 2
warn_on_root = 1


